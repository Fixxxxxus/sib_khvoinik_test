# Пример .env для прода на VDS. Скопируй в .env и заполни.
# Файл .env в git НЕ попадает — только локально на сервере.

# Django core
DJANGO_SECRET_KEY=замени-на-длинную-случайную-строку-50-символов
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=panel.gazony.ru,gazony.ru,www.gazony.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://panel.gazony.ru,https://gazony.ru,https://www.gazony.ru

# Путь к SQLite внутри контейнера (смонтирован через volume ./data/db)
DJANGO_DB_PATH=/app/db/db.sqlite3

# Каталог: True — из БД через админку, False — из pages/data.py
USE_DATABASE_CATALOG=1

# Календарь: 1 — из БД после migrate + seed_calendar_from_data. 0 или не задавать при DEBUG=0 — статика.
USE_DATABASE_CALENDAR=0

# HSTS. Сначала держи DJANGO_HSTS_SECONDS=0 и проверь, что всё работает по HTTPS.
# Потом подними до 3600 (час), позже 31536000 (год) + включи subdomains/preload.
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_HSTS_PRELOAD=0

# Ключи внешних API
YANDEX_MAPS_API_KEY=
