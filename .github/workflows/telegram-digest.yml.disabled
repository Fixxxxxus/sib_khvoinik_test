name: Telegram Digest

on:
  schedule:
    - cron: '0 5 * * 4'   # четверг 05:00 UTC = 12:00 NSK
  workflow_dispatch:         # ручной запуск для теста
    inputs:
      week:
        description: 'ISO неделя, например 2026-W21 (пусто = текущая)'
        required: false
        default: ''

jobs:
  send-digest:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: 'pip'

      - name: Install dependencies
        run: pip install requests

      - name: Send Telegram digest
        env:
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TG_API_SECRET: ${{ secrets.TG_API_SECRET }}
          CARE_API_BASE_URL: https://gazony.ru
          WEEK: ${{ github.event.inputs.week }}
        run: python .github/scripts/telegram_digest.py
