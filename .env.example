# Локально скопируйте в .env (файл .env в git не попадает).
# Ключ: JavaScript API + Геокодер в кабинете разработчика Яндекса.
YANDEX_MAPS_API_KEY=

# Каталог и календарь: при локальном DEBUG по умолчанию уже берутся из БД (админка).
# Чтобы принудительно показывать только статику из репозитория:
# USE_DATABASE_CATALOG=0
# USE_DATABASE_CALENDAR=0
# На проде без этих строк — статика; включение только из БД:
# USE_DATABASE_CATALOG=1
# USE_DATABASE_CALENDAR=1

# GitHub Pages:
# 1) Settings → Pages → Source: GitHub Actions (не «Deploy from a branch»).
# 2) Secrets → Actions → YANDEX_MAPS_API_KEY (точное имя). При необходимости дублируйте секрет
#    в Environment «github-pages»: Settings → Environments → github-pages.
# 3) После добавления секрета: Actions → Deploy GitHub Pages → Run workflow.
