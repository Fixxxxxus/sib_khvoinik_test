# Локально скопируйте в .env (файл .env в git не попадает).
# Ключ: JavaScript API + Геокодер в кабинете разработчика Яндекса.
YANDEX_MAPS_API_KEY=

# GitHub Pages: тот же ключ в репозитории → Settings → Secrets and variables → Actions
# → New repository secret → имя YANDEX_MAPS_API_KEY (подставится при деплое docs/).
